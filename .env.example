# Leave the edition set to selfhost for your own instance.
# SNIPTIDE_EDITION=selfhost

# Settings for `docker compose up -d` (docker-compose.yml). The install script writes .env for you:
#   curl -fsSL https://sniptide.com/install.sh | sh
# To write it by hand, copy this file to .env, or create it with
#   echo "BETTER_AUTH_SECRET=$(openssl rand -hex 32)" > .env
# Compose reads .env next to docker-compose.yml. Only BETTER_AUTH_SECRET is required; everything
# else is optional, and commented-out lines show the default. Every line here reaches the app, so
# any option from apps/web/.env.example (the full reference) works by adding it to .env.

# Required. Signs sessions and encrypts env group values. Keep it across restarts and upgrades:
# changing it signs everyone out and makes stored env values unreadable.
BETTER_AUTH_SECRET=

# The exact URL people open in the browser: http://<server-ip>:3000, or the public https:// URL
# behind a reverse proxy. Leave it unset with SNIPTIDE_DOMAIN below, which sets it to
# https://<SNIPTIDE_DOMAIN>. Sign-in is rejected from any other address ("Invalid origin").
# Use an HTTPS domain at its root for normal use. HTTP on a server IP is only a startup check:
# clipboard copying, password-protected paste unlocks, and CLI/MCP clients need HTTPS there.
BETTER_AUTH_URL=http://localhost:3000

# Password for the bundled Postgres. Only takes effect on the first start (the database keeps the
# password it was created with), so set it before the first `docker compose up`. Letters and
# digits only (`openssl rand -hex 16`), since it goes into a connection URL.
# POSTGRES_PASSWORD=sniptide

# Which published image to run. Pin a release for repeatable deployments, for example
# ghcr.io/dino-kupinic/sniptide:1.2.3. Build from source instead with `docker compose up -d --build`.
# SNIPTIDE_IMAGE=ghcr.io/dino-kupinic/sniptide:latest

# Host address and port the app listens on. Use SNIPTIDE_BIND=127.0.0.1 when a reverse proxy on
# this host is the only way in. POSTGRES_PORT is the port Postgres uses on 127.0.0.1.
# SNIPTIDE_BIND=0.0.0.0
# SNIPTIDE_PORT=3000
# POSTGRES_PORT=5432
# Set to postgres18 when migrating a Postgres 17 Compose volume.
# POSTGRES_VOLUME=postgres

# Optional per-container RAM ceilings (Docker sizes such as 1g). Zero leaves the ceiling unset.
# Node uses its normal heap sizing unless you supply NODE_OPTIONS.
# SNIPTIDE_MEMORY=0
# POSTGRES_MEMORY=0
# NODE_OPTIONS=

# HTTPS with the bundled Caddy proxy. The domain's DNS must point at this host, with ports 80 and
# 443 open. Set the domain, turn the proxy on, and remove BETTER_AUTH_URL above: the public address
# becomes https://<SNIPTIDE_DOMAIN>, and CLIENT_IP_SOURCE and TRUSTED_PROXIES default to
# x-forwarded-for and private. SNIPTIDE_BIND=127.0.0.1 keeps port 3000 off the internet.
# SNIPTIDE_DOMAIN=paste.example.com
# COMPOSE_PROFILES=proxy

# Sign-up and sign-in. Email and password always work. See apps/web/.env.example for details.
# ALLOW_SIGN_UP=first closes sign-up once the first account (yours) exists; false closes it now.
# ALLOW_SIGN_UP=true
# ALLOWED_EMAILS=ada@example.com,linus@example.com
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# A public demo: visitors share one guest account with example pastes, reset on a schedule. Pair it
# with ALLOW_SIGN_UP=false. See apps/web/.env.example.
# DEMO_MODE=false
# DEMO_RESET_MINUTES=60

# Rate limits count per visitor IP; tell the app where that comes from (direct, x-forwarded-for,
# x-real-ip or cloudflare). See apps/web/.env.example.
# With SNIPTIDE_DOMAIN set, the defaults are x-forwarded-for and private.
# CLIENT_IP_SOURCE=direct
# TRUSTED_PROXIES=
# TRUSTED_PROXY_HOPS=

# Pastes, integrations and product analytics. These integrations need a key or URL.
# Daily instance telemetry goes to Sniptide by default; TELEMETRY=off disables it.
# MAX_PASTE_SIZE=1MB
# ACCOUNT_STORAGE_BYTES=100MB
# ACCOUNT_PASTE_LIMIT=1000
# GITHUB_TOKEN=
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# Operator credential for GET /api/metrics and POST /api/jobs/{name} maintenance writes.
# METRICS_TOKEN=

# Advanced settings, such as cookie domains, the env group encryption key, database capacity and
# retention, are in apps/web/.env.example. Their defaults suit a small instance.

# Only for `docker compose up -d --build`: a version label (for example the commit SHA) baked into
# the build so rolling deployments agree on one release. See docs/scaling.md.
# DEPLOYMENT_VERSION=

# Optional notification emails. Configure host and sender together, with BETTER_AUTH_URL and a
# BETTER_AUTH_SECRET of at least 32 characters. Credentials must be supplied as a pair. The port
# defaults to 587 with STARTTLS; port 465 turns on implicit TLS.
# Users verify their email and opt in per event in Settings > Notifications.
# The same settings send password reset links and email change confirmations.
# In-app notifications and password sign-in work without SMTP.
# SMTP_HOST=smtp.example.com
# SMTP_FROM=notifications@example.com
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_PORT=587
# Only set SMTP_REQUIRE_TLS=false for a trusted local SMTP test server without TLS.
# SMTP_REQUIRE_TLS=true
# With SMTP, each new account gets one welcome email after its first sign-in. Set to false to
# turn it off. Demo instances never send it.
# WELCOME_EMAIL=true

# Optional. Release notes and news through Resend Broadcasts, for people who turn on Product
# updates in Settings. Both turn it on; BROADCAST_FROM is the sender `bun run broadcast` uses.
# RESEND_API_KEY=re_...
# RESEND_SEGMENT_ID=
# BROADCAST_FROM=Sniptide <updates@news.example.com>

# Daily instance reports go to Sniptide by default. Set off to disable.
TELEMETRY=on
