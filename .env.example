# Settings for `docker compose up -d` (docker-compose.yml). Copy to .env, or just create it with
#   echo "BETTER_AUTH_SECRET=$(openssl rand -hex 32)" > .env
# Compose reads .env next to docker-compose.yml. Only BETTER_AUTH_SECRET is required; everything
# else is optional, and commented-out lines show the default. The full reference for what each
# option does is apps/web/.env.example.

# Required. Signs sessions and encrypts env group values. Keep it across restarts and upgrades:
# changing it signs everyone out and makes stored env values unreadable.
BETTER_AUTH_SECRET=

# The exact URL people open in the browser: http://<server-ip>:3000, or the public https:// URL
# behind a reverse proxy. Sign-in is rejected from any other address ("Invalid origin").
BETTER_AUTH_URL=http://localhost:3000

# Password for the bundled Postgres. Only takes effect on the first start (the database keeps the
# password it was created with), so set it before the first `docker compose up`. Letters and
# digits only (`openssl rand -hex 16`), since it goes into a connection URL.
# POSTGRES_PASSWORD=sniptide

# Which published image to run. Pin a release for repeatable deployments, for example
# ghcr.io/dino-kupinic/sniptide:1.2.3. Build from source instead with `docker compose up -d --build`.
# SNIPTIDE_IMAGE=ghcr.io/dino-kupinic/sniptide:latest

# Host address and port the app listens on. Use SNIPTIDE_BIND=127.0.0.1 when a reverse proxy on
# this host is the only way in. POSTGRES_PORT is the port Postgres uses on 127.0.0.1.
# SNIPTIDE_BIND=0.0.0.0
# SNIPTIDE_PORT=3000
# POSTGRES_PORT=5432

# HTTPS with the bundled Caddy proxy: `docker compose --profile proxy up -d`. The domain's DNS
# must point at this host, with ports 80 and 443 open. Also set BETTER_AUTH_URL=https://<domain>,
# CLIENT_IP_SOURCE=x-forwarded-for and TRUSTED_PROXIES=private.
# SNIPTIDE_DOMAIN=paste.example.com

# Sign-up and sign-in. Email and password always work. See apps/web/.env.example for details.
# ALLOW_SIGN_UP=true
# ALLOWED_EMAILS=ada@example.com,linus@example.com
# WAITLIST_URL=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# A public demo: visitors share one guest account with example pastes, reset on a schedule. Pair it
# with ALLOW_SIGN_UP=false. See apps/web/.env.example.
# DEMO_MODE=false
# DEMO_RESET_MINUTES=60

# Rate limits count per visitor IP; tell the app where that comes from (direct, x-forwarded-for,
# x-real-ip or cloudflare). See apps/web/.env.example.
# CLIENT_IP_SOURCE=direct
# TRUSTED_PROXIES=
# TRUSTED_PROXY_HOPS=

# Pastes, integrations and analytics. Nothing is sent anywhere unless you set a key or URL.
# MAX_PASTE_SIZE=1MB
# GITHUB_TOKEN=
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# METRICS_TOKEN=

# Advanced: auth cookies and domains, encryption key, capacity limits and retention.
# ENV_SECRETS_KEY=
# BETTER_AUTH_TRUSTED_ORIGINS=
# SHARE_URL=
# SHARE_PROXY_SECRET=
# COOKIE_DOMAIN=
# COOKIE_PREFIX=
# DATABASE_POOL_SIZE=10
# DATABASE_CONNECT_TIMEOUT_SECONDS=10
# DATABASE_IDLE_TIMEOUT_SECONDS=20
# DATABASE_MAX_LIFETIME_SECONDS=1800
# DATABASE_STATEMENT_TIMEOUT_MS=10000
# DATABASE_LOCK_TIMEOUT_MS=3000
# DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=15000
# ACCOUNT_STORAGE_BYTES=1073741824
# ACCOUNT_PASTE_LIMIT=10000
# VIEW_HISTORY_RETENTION_DAYS=90
# ANALYTICS_RETENTION_DAYS=180
# PURGE_BATCH_SIZE=500
# PURGE_TIME_BUDGET_MS=2000
# HIGHLIGHT_CACHE_BYTES=33554432
# SLOW_QUERY_MS=500

# Only for `docker compose up -d --build`: a version label (for example the commit SHA) baked into
# the build so rolling deployments agree on one release. See docs/scaling.md.
# DEPLOYMENT_VERSION=
