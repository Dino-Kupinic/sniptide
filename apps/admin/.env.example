# The admin app runs next to a hosted Sniptide instance and shares its database and Resend segment.

# The Sniptide database, for drafts and the subscriber count. Run the app's migrations first.
DATABASE_URL=postgres://sniptide:sniptide@localhost:5432/sniptide
# The Sniptide app, which serves the logo and fonts that the emails load and that links point to.
APP_URL=http://localhost:3000
# The one operator password, at least 16 characters. Changing it signs every session out.
ADMIN_PASSWORD=

# The same Resend key and segment as the app.
RESEND_API_KEY=re_...
RESEND_SEGMENT_ID=
# The sender, on a subdomain of your own so complaints can't affect the app's email.
BROADCAST_FROM=Sniptide <updates@news.example.com>
# Where "Send test" delivers a copy.
BROADCAST_TEST_TO=you@example.com

# Marketing email names its sender with a postal address. Sending to subscribers needs the name.
OPERATOR_NAME=
OPERATOR_ADDRESS=
