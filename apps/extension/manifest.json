{
  "manifest_version": 3,
  "name": "Sniptide",
  "description": "Save a selection or a code block from any page as a Sniptide paste and copy its link.",
  "version": "0.0.0",
  "minimum_chrome_version": "127",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Sniptide",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "contextMenus", "identity", "scripting", "storage"],
  "host_permissions": ["https://app.sniptide.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "commands": {
    "save-selection": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save the selection to Sniptide"
    }
  }
}
