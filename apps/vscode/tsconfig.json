{
  "extends": "@workspace/typescript/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "lib": ["es2022", "DOM"],
    "types": ["vscode", "bun"],
    "paths": {
      // The SDK publishes its build output, so the extension reads the source and needs no
      // build of the package first.
      "@sniptide/sdk": ["../../packages/sdk/src/index.ts"]
    }
  },
  "include": ["src", "scripts", "test"]
}
