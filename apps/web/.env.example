# Every option the app reads, with its default. Settings are checked together (lib/config.ts):
# a value the app can't understand stops the server with the variable's name. A line left empty
# counts as unset. Options marked Optional have a default; commented-out lines show the default
# or an example.
#
# Copy to .env.local for `bun dev`. In production these are set as environment variables in
# Coolify. `docker compose up -d db` starts the local Postgres this DATABASE_URL points at.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=postgres://sniptide:sniptide@localhost:5432/sniptide

# Optional. Extra origins allowed to call the auth API, comma-separated, besides BETTER_AUTH_URL
# (for example a preview domain or a second hostname for the same app).
# BETTER_AUTH_TRUSTED_ORIGINS=https://preview.example.com,https://www.example.com

# Optional. Domain share links use when it differs from the app's (sniptide.com runs the app on
# app.sniptide.com and serves share links from sniptide.com). Leave unset when self-hosting.
# SHARE_URL=https://sniptide.com

# Optional. Share the session cookie with other subdomains, so the landing page on sniptide.com
# can send signed-in visitors to the app. Set it to the parent domain (sniptide.com). Leave unset
# when self-hosting on one domain.
# COOKIE_DOMAIN=sniptide.com

# Optional. Where rate limits get the visitor's IP. Pick what sits in front of the app; a header
# is only safe if clients can't reach the app without going through whatever sets it.
#   direct           (default) No proxy: the TCP peer is the visitor. No header can fake it, but
#                    behind a proxy every visitor shares the proxy's address and one limit.
#   x-forwarded-for  A reverse proxy (nginx, Caddy, Traefik, Coolify) that appends to
#                    X-Forwarded-For. Set TRUSTED_PROXIES or TRUSTED_PROXY_HOPS below.
#   x-real-ip        A reverse proxy that sets X-Real-IP to the address it saw (nginx:
#                    proxy_set_header X-Real-IP $remote_addr).
#   cloudflare       Cloudflare's CF-Connecting-IP. Only when the origin accepts nothing but
#                    Cloudflare (firewall to Cloudflare's ranges, or a Cloudflare Tunnel).
# When the chosen header is missing or invalid, the TCP peer is used.
# CLIENT_IP_SOURCE=direct

# Optional, for CLIENT_IP_SOURCE=x-forwarded-for. Either list your proxies' addresses or ranges
# (comma-separated; "private" covers loopback and the private ranges Docker networks use), and the
# visitor is the first address from the right that isn't one of them:
# TRUSTED_PROXIES=private
# Or, without a list, how many proxies append to X-Forwarded-For (default 1). The visitor is that
# many entries from the right.
# TRUSTED_PROXY_HOPS=1

# Optional. Shared with the share domain's site when it proxies share pages to this app: it then
# sends the visitor's IP in X-Sniptide-Client-IP along with this value in X-Sniptide-Proxy-Secret.
# SHARE_PROXY_SECRET=

# Optional. The most one paste can hold, summed across its files. Plain bytes or a number with a
# unit: B, KB, MB, GB (1 KB = 1024 bytes), so "1MB", "512KB", "1.5MB" and "1048576" all work.
# Pastes over it are refused in the editor, and gist imports leave out files over it.
# MAX_PASTE_SIZE=1MB

# Optional. A GitHub token (no scopes needed) for gist imports. Without it the server shares
# GitHub's unauthenticated quota of 60 requests an hour.
# GITHUB_TOKEN=

# Optional. Where the database migrations are read from at startup. The Docker image sets this;
# leave it unset when running from the repo.
# MIGRATIONS_DIR=

# Optional OAuth apps. Leave unset to show the GitHub / Google buttons as disabled.
# Callback URLs: <BETTER_AUTH_URL>/api/auth/callback/github and /api/auth/callback/google
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
