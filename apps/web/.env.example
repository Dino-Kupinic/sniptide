# Copy to .env.local for `bun dev`. In production these are set as environment variables in
# Coolify. `docker compose up -d db` starts the local Postgres this DATABASE_URL points at.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=postgres://sniptide:sniptide@localhost:5432/sniptide

# Optional. Domain share links use when it differs from the app's (sniptide.com runs the app on
# app.sniptide.com and serves share links from sniptide.com). Leave unset when self-hosting.
# SHARE_URL=https://sniptide.com

# Optional OAuth apps. Leave unset to show the GitHub / Google buttons as disabled.
# Callback URLs: <BETTER_AUTH_URL>/api/auth/callback/github and /api/auth/callback/google
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
