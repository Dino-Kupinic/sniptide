# Copy to .env.local for `bun dev`. In production these are set as environment variables in
# Coolify; DATABASE_URL there is file:/data/sniptide.db (the persistent volume).
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=file:./data/sniptide.db

# Optional OAuth apps. Leave unset to show the GitHub / Google buttons as disabled.
# Callback URLs: <BETTER_AUTH_URL>/api/auth/callback/github and /api/auth/callback/google
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
