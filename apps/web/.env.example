# The app boots with only DATABASE_URL and BETTER_AUTH_SECRET set; add BETTER_AUTH_URL so browsers
# can sign in. Everything else is optional, off or defaulted, and self-hosted instances send
# nothing anywhere (no analytics, no OAuth).
# Every option the app reads, with its default. Settings are checked together (lib/config.ts):
# a value the app can't understand stops the server with the variable's name. A line left empty
# counts as unset. Options marked Optional have a default; commented-out lines show the default
# or an example.
#
# Copy to .env.local for `bun dev`. In production these are set as environment variables in
# Coolify. `docker compose up -d db` starts the local Postgres this DATABASE_URL points at.
# Required. Signs sessions and, unless ENV_SECRETS_KEY is set, encrypts env group values. Generate
# with `openssl rand -hex 32` and keep it across restarts.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Set this to the exact URL people open in the browser (https:// behind a reverse proxy). Sign-in
# and sign-up are rejected from any other origin ("Invalid origin"), and OAuth callbacks and the
# links the app prints use it. The app still boots without it, but browsers can't sign in.
BETTER_AUTH_URL=http://localhost:3000
# Required. Postgres 17 is what Sniptide is built and tested against.
DATABASE_URL=postgres://sniptide:sniptide@localhost:5432/sniptide

# Optional. Key that encrypts env group values (`sniptide env push`) in the database, at least 32
# characters. Defaults to a key derived from BETTER_AUTH_SECRET. Changing whichever one is in use
# makes stored env values unreadable until they're pushed again, so set this before rotating the
# auth secret.
# ENV_SECRETS_KEY=replace-with-another-long-random-secret

# Optional. Extra origins allowed to call the auth API, comma-separated, besides BETTER_AUTH_URL
# (for example a preview domain or a second hostname for the same app).
# BETTER_AUTH_TRUSTED_ORIGINS=https://preview.example.com,https://www.example.com

# Optional. Domain share links use when it differs from the app's (sniptide.com runs the app on
# app.sniptide.com and serves share links from sniptide.com). Leave unset when self-hosting.
# SHARE_URL=https://sniptide.com

# Optional. Where the logo on the sign-in screens leads, such as a landing page. Leave unset when
# self-hosting and the logo stays where it is.
# HOME_URL=https://sniptide.com/home

# Optional. Where the Homepage, Documentation and Help links in the account menu go. They open in a
# new tab. The defaults point at the Sniptide project; set them to your own site, wiki or support
# page when self-hosting.
# HOMEPAGE_URL=https://sniptide.com
# DOCS_URL=https://docs.sniptide.com
# HELP_URL=https://github.com/Dino-Kupinic/sniptide/issues

# Optional. Share the session cookie with other subdomains, so the landing page on sniptide.com
# can send signed-in visitors to the app. Set it to the parent domain (sniptide.com). Leave unset
# when self-hosting on one domain.
# COOKIE_DOMAIN=sniptide.com

# Optional. Prefix for the auth cookies' names (`<prefix>.session_token`); the default is
# better-auth. Set a different one on any deployment that runs under the same parent domain as
# another with its own BETTER_AUTH_SECRET or database, such as a PR preview next to production,
# so the two never read each other's session cookie. Letters, digits, - and _ only. Changing it
# signs everyone out, so leave production on the default.
# COOKIE_PREFIX=preview

# Optional. Whether anyone can create an account. Defaults to true: open sign-up with email and
# password (GitHub and Google too, when configured). Set to false to close sign-up for everyone,
# for example once you've created your own account; existing accounts keep signing in. It wins
# over ALLOWED_EMAILS below.
# ALLOW_SIGN_UP=true

# Optional. Public demo instance: visitors are signed in to one shared guest account with example
# pastes and collections, no sign-up needed, and that account is reset to the examples on a
# schedule. Set ALLOW_SIGN_UP=false next to it, so the guest is the only account. Pastes made in
# the demo are visible to every visitor and deleted at the next reset. Leave unset on a normal
# instance.
# DEMO_MODE=false
# Optional, with DEMO_MODE. Minutes between resets of the guest account (5 to 1440). The guest is
# also reset whenever the server starts.
# DEMO_RESET_MINUTES=60

# Optional. Invite-only sign-up: only these emails (comma-separated) can create an account.
# Existing accounts keep signing in. Leave unset to let anyone sign up.
# New password accounts must verify their email through configured SMTP before signing in.
# Without SMTP, only verified OAuth identities can join an invite-only instance.
# ALLOWED_EMAILS=ada@example.com,linus@example.com
# While ALLOWED_EMAILS is set, the sign-up page links here so visitors can apply for an invite.
# WAITLIST_URL=https://form.fillout.com/t/877U9YVJi8us

# Optional. Where rate limits get the visitor's IP. Pick what sits in front of the app; a header
# is only safe if clients can't reach the app without going through whatever sets it.
#   direct           (default) No proxy: the TCP peer is the visitor. No header can fake it, but
#                    behind a proxy every visitor shares the proxy's address and one limit.
#   x-forwarded-for  A reverse proxy (nginx, Caddy, Traefik, Coolify) that appends to
#                    X-Forwarded-For. Set TRUSTED_PROXIES or TRUSTED_PROXY_HOPS below.
#   x-real-ip        A reverse proxy that sets X-Real-IP to the address it saw (nginx:
#                    proxy_set_header X-Real-IP $remote_addr).
#   cloudflare       Cloudflare's CF-Connecting-IP. Only when the origin accepts nothing but
#                    Cloudflare (firewall to Cloudflare's ranges, or a Cloudflare Tunnel).
# When the chosen header is missing or invalid, the TCP peer is used.
# CLIENT_IP_SOURCE=direct

# Optional, for CLIENT_IP_SOURCE=x-forwarded-for. Either list your proxies' addresses or ranges
# (comma-separated; "private" covers loopback and the private ranges Docker networks use), and the
# visitor is the first address from the right that isn't one of them:
# TRUSTED_PROXIES=private
# Or, without a list, how many proxies append to X-Forwarded-For (default 1). The visitor is that
# many entries from the right.
# TRUSTED_PROXY_HOPS=1

# Optional. Shared with the share domain's site when it proxies share pages to this app: it then
# sends the visitor's IP in X-Sniptide-Client-IP along with this value in X-Sniptide-Proxy-Secret.
# SHARE_PROXY_SECRET=

# Optional. The most one paste can hold, summed across its files. Plain bytes or a number with a
# unit: B, KB, MB, GB (1 KB = 1024 bytes), so "1MB", "512KB", "1.5MB" and "1048576" all work.
# Pastes over it are refused in the editor, and gist imports leave out files over it.
# MAX_PASTE_SIZE=1MB

# Optional. What one account can keep before it has to delete something: the combined size of its
# pastes (the same units as MAX_PASTE_SIZE, or plain bytes) and how many pastes it has. Trash counts
# until it is emptied. Both are checked on every create, edit and restore, and an account over a
# limit can still delete and shrink pastes. Set either to "unlimited" (or 0) to remove it, which
# suits a server you run for yourself.
# ACCOUNT_STORAGE_BYTES=100MB
# ACCOUNT_PASTE_LIMIT=1000

# Optional. A GitHub token (no scopes needed) for gist imports. Without it the server shares
# GitHub's unauthenticated quota of 60 requests an hour.
# GITHUB_TOKEN=

# Optional. Incoming webhooks for the Share dialog. One channel per provider for this instance;
# all signed-in paste owners can post to it (20 shares/hour/account). Keep these URLs secret.
# Only public/unlisted, live pastes without a password or one-time protection can be posted.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789/...

# Optional. Where the database migrations are read from at startup. The Docker image sets this;
# leave it unset when running from the repo.
# MIGRATIONS_DIR=

# Optional. PostHog product analytics, off unless a key is set, so self-hosted instances send
# nothing. Cookieless (turn on "Cookieless server hash mode" in the PostHog project), no session
# replay, and events never include paste content or slugs. Read at runtime, not baked into the
# build. POSTHOG_HOST picks the region: https://us.i.posthog.com (default) or
# https://eu.i.posthog.com.
# POSTHOG_KEY=phc_...
# POSTHOG_HOST=https://us.i.posthog.com

# Optional OAuth apps. Email and password sign-in always works; these only add buttons. Leave unset
# to show the GitHub / Google buttons as disabled.
# Callback URLs: <BETTER_AUTH_URL>/api/auth/callback/github and /api/auth/callback/google
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Early-growth capacity controls. Pool size is per process: replica count * pool size plus
# migration/admin connections must fit the Postgres connection budget.
# DATABASE_POOL_SIZE=10
# DATABASE_CONNECT_TIMEOUT_SECONDS=10
# DATABASE_IDLE_TIMEOUT_SECONDS=20
# DATABASE_MAX_LIFETIME_SECONDS=1800
# DATABASE_STATEMENT_TIMEOUT_MS=10000
# DATABASE_LOCK_TIMEOUT_MS=3000
# DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=15000
# VIEW_HISTORY_RETENTION_DAYS=90
# ANALYTICS_RETENTION_DAYS=180
# PURGE_BATCH_SIZE=500
# PURGE_TIME_BUDGET_MS=2000
# HIGHLIGHT_CACHE_BYTES=33554432
# SLOW_QUERY_MS=500

# Optional. A long random bearer token enables GET /api/metrics. Keep it in your monitoring
# service's secret store. Without it the endpoint returns 404.
# METRICS_TOKEN=

# Build-time settings for rolling deployments. Use the same version for all replicas of one
# release; build once and deploy that image. In Docker pass DEPLOYMENT_VERSION as a build arg.
# DEPLOYMENT_VERSION=<commit-sha>
# For independently built containers, share a stable Server Actions key at build time via
# Docker BuildKit secret server_actions_key (see docs/scaling.md). Never commit the key.

# Optional notification emails. Configure host, port and sender together, with BETTER_AUTH_URL
# and a BETTER_AUTH_SECRET of at least 32 characters. Credentials must be supplied as a pair.
# Users verify their email and opt in per event in Settings > Notifications.
# The same settings send password reset links and email change confirmations.
# In-app notifications and password sign-in work without SMTP.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=notifications@example.com
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# Use SMTP_SECURE=true for implicit TLS on port 465. SMTP_REQUIRE_TLS requires STARTTLS otherwise.
# Only set SMTP_REQUIRE_TLS=false for a trusted local SMTP test server without TLS.
