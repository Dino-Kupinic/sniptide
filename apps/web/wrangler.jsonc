{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sniptide",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Smaller upload: the Worker limit is on the compressed bundle (3 MB free, 10 MB paid).
  "minify": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sniptide",
      "database_id": "73ceefcb-2ed9-4ab3-8797-5991332ff89e",
      "migrations_dir": "../../packages/db/migrations",
      "migrations_pattern": "../../packages/db/migrations/*/migration.sql"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://sniptide.com"
  }
}
