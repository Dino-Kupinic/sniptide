{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    "apps/docs": {
      // The exported @sniptide/ui PostCSS config loads this plugin in each consumer's build.
      "ignoreDependencies": ["@tailwindcss/postcss"]
    },
    "apps/web": {
      "entry": [
        "scripts/**/*.ts",
        "test/**/*.test.ts",
        "tests/**/*.e2e.ts",
        // React Email previews, opened by `bun run email`.
        "emails/*.tsx"
      ],
      // The exported @sniptide/ui PostCSS config loads this plugin in each consumer's build.
      "ignoreDependencies": ["@tailwindcss/postcss"]
    },
    "apps/extension": {
      "entry": ["src/background.ts", "src/popup/main.tsx", "test/**/*.test.ts"],
      // scripts/build.ts copies the font files by path, and popup.css imports Tailwind through
      // the @sniptide/ui theme.
      "ignoreDependencies": [
        "@fontsource-variable/archivo",
        "@fontsource-variable/inter",
        "tailwindcss"
      ]
    },
    "apps/vscode": {
      "entry": ["src/extension.ts", "test/**/*.test.ts"]
    },
    "packages/ui": {
      // shadcn generates components on demand; postcss-load-config appears only in a JSDoc type.
      "ignoreDependencies": ["shadcn", "postcss-load-config"]
    },
    "packages/auth": {
      // Better Auth's inferred exported types need a direct Zod reference for portable declarations.
      "ignoreDependencies": ["zod"]
    }
  }
}
