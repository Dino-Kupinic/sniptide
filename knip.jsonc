{
  "$schema": "./node_modules/knip/schema.json",
  // A type that an exported signature in the same file names has to stay exported for declaration
  // output, even when no other file imports it.
  "ignoreExportsUsedInFile": { "interface": true, "type": true },
  "workspaces": {
    ".": {
      // Node tests for the deploy and release scripts, run by name in CI.
      "entry": ["scripts/*.{mjs,cjs}"]
    },
    "apps/docs": {
      // The Docker image's health probe, copied in by apps/docs/Dockerfile.
      "entry": ["healthcheck.cjs"],
      // The exported @sniptide/ui PostCSS config loads this plugin in each consumer's build.
      "ignoreDependencies": ["@tailwindcss/postcss"]
    },
    "apps/admin": {
      // The Docker image's health probe, copied in by apps/admin/Dockerfile.
      "entry": ["healthcheck.cjs", "test/**/*.test.ts"],
      // The exported @sniptide/ui PostCSS config loads this plugin in each consumer's build.
      "ignoreDependencies": ["@tailwindcss/postcss"]
    },
    "apps/web": {
      "entry": [
        "scripts/**/*.ts",
        "test/**/*.test.ts",
        // Programs the tests start in a process of their own.
        "test/fixtures/*.ts",
        "test/request-admission.node.ts",
        "tests/**/*.e2e.ts",
        "e2e.config.ts",
        // Declares the app's locales to next-intl through module augmentation.
        "i18n/types.ts",
        // React Email previews, opened by `bun run email`.
        "emails/**/*.tsx"
      ],
      // The dither code is vendored from dithercn and keeps the exports it ships with.
      "ignore": ["lib/dither/**"],
      // The exported @sniptide/ui PostCSS config loads this plugin in each consumer's build.
      "ignoreDependencies": ["@tailwindcss/postcss"]
    },
    "apps/extension": {
      // scripts/build.ts reads the two style sheets by path.
      "entry": [
        "src/background.ts",
        "src/popup/main.tsx",
        "src/popup/popup.css",
        "public/fonts.css",
        "test/**/*.test.ts"
      ],
      // scripts/build.ts copies the font files by path, and popup.css imports Tailwind through
      // the @sniptide/ui theme.
      "ignoreDependencies": [
        "@fontsource-variable/archivo",
        "@fontsource-variable/inter",
        "tailwindcss"
      ]
    },
    "apps/vscode": {
      "entry": ["src/extension.ts", "test/**/*.test.ts"]
    },
    "packages/cli": {
      "entry": ["src/bin.ts", "test/**/*.test.ts"]
    },
    "packages/mcp": {
      "entry": ["src/bin.ts", "test/**/*.test.ts"]
    },
    // Raycast installs with npm outside the Bun workspaces. Its manifest lists a command per file
    // in src.
    "plugins/raycast": {
      "entry": ["src/*.{ts,tsx}", "test/**/*.test.ts"],
      // @raycast/api brings React and the `ray` command, and `ray lint` runs ESLint and Prettier.
      // The compiler alias supplies `tsc`; CI analyzes dependencies before the npm install.
      "ignoreDependencies": ["react", "prettier", "@typescript/native"],
      "ignoreBinaries": ["ray", "eslint", "prettier"]
    },
    "packages/ui": {
      // shadcn generates components on demand; postcss-load-config appears only in a JSDoc type.
      "ignoreDependencies": ["shadcn", "postcss-load-config"]
    }
  }
}
