{
  "name": "sniptide",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "check": "biome ci . && bun run typecheck",
    "check:deps": "knip --include dependencies,unlisted,binaries",
    "audit:deps": "bun audit --audit-level=moderate",
    "test": "bun run test:cli && bun run test:mcp && bun run test:docs && bun run test:web",
    "test:docs": "bun --filter docs test",
    "test:web": "bun --filter web test",
    "prepare": "husky",
    "cli": "bun packages/cli/src/bin.ts",
    "test:cli": "bun --filter @sniptide/cli test",
    "mcp": "bun packages/mcp/src/bin.ts",
    "test:mcp": "bun --filter @sniptide/mcp test",
    "load:seed": "bun apps/web/load/seed.ts",
    "load:run": "bun apps/web/load/run.ts",
    "test:e2e": "bun --filter web test:e2e"
  },
  "catalogs": {
    "docs": {
      "@types/mdx": "^2.0.14",
      "fumadocs-core": "16.17.8",
      "fumadocs-mdx": "15.4.10",
      "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.7",
      "lucide-react": "^1.60.0"
    },
    "runtime": {
      "@better-auth/drizzle-adapter": "^1.7.12",
      "@modelcontextprotocol/sdk": "1.32.2",
      "@scalar/api-reference-react": "^0.9.83",
      "@shikijs/langs": "^4.5.0",
      "better-auth": "^1.7.12",
      "drizzle-orm": "1.0.0-rc.4",
      "next": "16.4.3",
      "next-themes": "^0.4.6",
      "postgres": "^3.4.7",
      "posthog-js": "^1.438.21",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "server-only": "^0.0.1",
      "shiki": "^4.5.0",
      "zod": "4.6.7"
    },
    "ui": {
      "@base-ui/react": "^1.8.0",
      "@tailwindcss/postcss": "^4",
      "class-variance-authority": "^0.7.1",
      "cn": "^0.5.0",
      "flag-icons": "^7.5.0",
      "lucide-react": "^1.43.0",
      "shadcn": "^4.22.1",
      "tailwindcss": "^4",
      "tw-animate-css": "^1.4.0"
    },
    "tooling": {
      "@biomejs/biome": "2.6.3",
      "@commitlint/cli": "^21.2.4",
      "@commitlint/config-conventional": "^21.2.4",
      "@types/bun": "1.4.4",
      "@types/node": "^24.19.2",
      "@types/react": "^19",
      "@types/react-dom": "^19",
      "dotenv": "^17.4.2",
      "drizzle-kit": "1.0.0-rc.4",
      "husky": "^9.1.7",
      "knip": "6.43.0",
      "turbo": "^2.11.10",
      "typescript": "^5"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:tooling",
    "@commitlint/cli": "catalog:tooling",
    "@commitlint/config-conventional": "catalog:tooling",
    "@workspace/typescript": "workspace:*",
    "husky": "catalog:tooling",
    "knip": "catalog:tooling",
    "tar": "7.5.22",
    "turbo": "catalog:tooling",
    "typescript": "catalog:tooling"
  },
  "overrides": {
    "zod": "4.6.7"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=24.8.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
