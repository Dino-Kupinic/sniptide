{
  "name": "@sniptide/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Capture and reuse code with Sniptide from a terminal or coding agent.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "sniptide": "dist/sniptide.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "bun build src/bin.ts --target=node --outfile=dist/sniptide.js",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test"
  },
  "devDependencies": {
    "@types/bun": "catalog:tooling",
    "@types/node": "catalog:tooling",
    "@workspace/typescript": "workspace:*",
    "typescript": "catalog:tooling"
  }
}
