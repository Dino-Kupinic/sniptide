{
  "name": "@workspace/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/migrate-cli.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:runtime",
    "postgres": "catalog:runtime"
  },
  "devDependencies": {
    "@types/node": "catalog:tooling",
    "@workspace/typescript": "workspace:*",
    "dotenv": "catalog:tooling",
    "drizzle-kit": "catalog:tooling",
    "typescript": "catalog:tooling"
  },
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./migrate": "./src/migrate.ts",
    "./config": "./src/config.ts"
  }
}
