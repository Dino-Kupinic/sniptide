{
  "name": "@workspace/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply sniptide --local --config ../../apps/web/wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply sniptide --remote --config ../../apps/web/wrangler.jsonc"
  },
  "dependencies": {
    "drizzle-orm": "catalog:runtime"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:tooling",
    "@workspace/typescript": "workspace:*",
    "dotenv": "catalog:tooling",
    "drizzle-kit": "catalog:tooling",
    "typescript": "catalog:tooling",
    "wrangler": "catalog:tooling"
  },
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  }
}
