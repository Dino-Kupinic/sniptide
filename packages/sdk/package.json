{
  "name": "@sniptide/sdk",
  "version": "0.1.3",
  "description": "Official Sniptide SDK for JavaScript and TypeScript: snippets, collections, environment variables, and account usage.",
  "license": "MIT",
  "homepage": "https://sniptide.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dino-Kupinic/sniptide.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "catalog:tooling"
  },
  "keywords": [
    "sniptide",
    "sdk",
    "api-client",
    "code-snippets",
    "collections",
    "environment-variables",
    "typescript"
  ]
}
