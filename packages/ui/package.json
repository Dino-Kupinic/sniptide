{
  "name": "@sniptide/ui",
  "version": "0.1.1",
  "description": "Sniptide's shared React components and Tailwind theme, used by the app and the website.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dino-Kupinic/sniptide.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "postcss.config.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@base-ui/react": "catalog:ui",
    "@tailwindcss/postcss": "catalog:ui",
    "class-variance-authority": "catalog:ui",
    "cn": "catalog:ui",
    "lucide-react": "catalog:ui",
    "shadcn": "catalog:ui",
    "tailwindcss": "catalog:ui",
    "tw-animate-css": "catalog:ui"
  },
  "devDependencies": {
    "@turbo/gen": "catalog:tooling",
    "@types/node": "catalog:tooling",
    "@types/react": "catalog:tooling",
    "@types/react-dom": "catalog:tooling",
    "@workspace/typescript": "workspace:*",
    "react": "catalog:runtime",
    "react-dom": "catalog:runtime",
    "typescript": "catalog:tooling"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./postcss.config": "./postcss.config.mjs",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  }
}
