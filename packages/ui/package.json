{
  "name": "@workspace/ui",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:ui",
    "class-variance-authority": "catalog:ui",
    "cn": "catalog:ui",
    "lucide-react": "catalog:ui",
    "next-themes": "catalog:runtime",
    "react": "catalog:runtime",
    "react-dom": "catalog:runtime",
    "shadcn": "catalog:ui",
    "tw-animate-css": "catalog:ui",
    "zod": "catalog:runtime"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:ui",
    "@turbo/gen": "catalog:tooling",
    "@types/node": "catalog:tooling",
    "@types/react": "catalog:tooling",
    "@types/react-dom": "catalog:tooling",
    "@workspace/typescript": "workspace:*",
    "tailwindcss": "catalog:ui",
    "typescript": "catalog:tooling"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./postcss.config": "./postcss.config.mjs",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
