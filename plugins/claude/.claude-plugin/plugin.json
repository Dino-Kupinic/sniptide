{
  "name": "sniptide",
  "displayName": "Sniptide",
  "version": "0.6.0",
  "description": "Search, read and save your Sniptide snippets and collections from a coding agent.",
  "author": {
    "name": "Dino Kupinic",
    "email": "dinokupinic2006@gmail.com"
  },
  "homepage": "https://sniptide.com",
  "repository": "https://github.com/Dino-Kupinic/sniptide",
  "license": "AGPL-3.0-only",
  "privacyPolicyUrl": "https://sniptide.com/privacy",
  "icon": ".claude-plugin/icon.png",
  "keywords": ["pastebin", "mcp", "snippets"],
  "supportUrl": "https://github.com/Dino-Kupinic/sniptide/issues",
  "userConfig": {
    "api_token": {
      "type": "string",
      "title": "Sniptide API token",
      "description": "Optional personal API token from Settings > API tokens. Leave it empty to sign in with OAuth.",
      "sensitive": true,
      "required": false
    }
  },
  "mcpServers": {
    "sniptide": {
      "type": "http",
      "url": "https://app.sniptide.com/api/mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.api_token}"
      }
    }
  }
}
